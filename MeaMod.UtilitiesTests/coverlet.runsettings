<?xml version="1.0" encoding="utf-8"?>
<!-- Pass this file to dotnet test with the settings option to collect coverage with the exclusions below;
     the collector configured here then runs without a separate collect option. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Resource designer files and compiler-generated members are not product code. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
